# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Subscribed Users (Comma-separated chat IDs for daily reports)
# Users are automatically added when they interact with the bot
# Format: "123456789,987654321,111222333"
# Get chat IDs from users by having them send /status command
TELEGRAM_SUBSCRIBED_USERS=your_chat_id_here

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Cron Job Security
CRON_SECRET=your_cron_secret_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env.local to Git (it's already in .gitignore)
# 4. For TELEGRAM_SUBSCRIBED_USERS: Add chat IDs as users interact with the bot
